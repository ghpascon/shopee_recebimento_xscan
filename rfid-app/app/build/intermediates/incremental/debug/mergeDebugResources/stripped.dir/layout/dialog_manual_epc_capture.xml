<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/textManualEpcInstructions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/home_manual_epc_instructions"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <TextView
        android:id="@+id/textManualEpcCapture"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_spinner"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:fontFamily="monospace"
        android:minHeight="64dp"
        android:padding="16dp"
        android:text="@string/home_manual_epc_waiting"
        android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
        android:textColor="?attr/colorOnSurface"
        android:textIsSelectable="false" />

    <EditText
        android:id="@+id/editManualEpcWedgeReceiver"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:alpha="0.01"
        android:importantForAccessibility="no"
        android:inputType="textCapCharacters|textNoSuggestions"
        android:singleLine="true"
        android:imeOptions="actionDone" />

    <TextView
        android:id="@+id/textManualEpcStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
        android:textColor="?attr/colorError"
        android:visibility="gone" />
</LinearLayout>